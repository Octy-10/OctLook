{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OctLook",
  "version": "0.2.3",
  "identifier": "app.octlook.viewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && cargo build --release -p octlook-shell --manifest-path src-tauri/Cargo.toml",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OctLook",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 420,
        "decorations": false,
        "dragDropEnabled": true,
        "center": true,
        "visible": false,
        "backgroundColor": "#0B0B0D"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost blob:; worker-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "十月",
    "homepage": "https://github.com/Octy-10",
    "copyright": "© 2026 十月",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "target/release/octlook_shell.dll": "octlook_shell.dll",
      "resources/ocr/det.onnx": "ocr/det.onnx",
      "resources/ocr/rec.onnx": "ocr/rec.onnx",
      "resources/ocr/dict.txt": "ocr/dict.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/installer-hooks.nsh",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyQjNBREQ0OUE4MDRENjIKUldSaVRZQ2ExSzJ6OGk2UDJYRUU3MlNIQkdKYUI3VkVYeldwWEptUGFkaDM0dlBYZ3pXQm1JTnQK",
      "endpoints": [
        "https://github.com/Octy-10/OctLook/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
