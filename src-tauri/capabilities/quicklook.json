{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "quicklook",
  "description": "Space preview and pinned preview windows: listen for files, drag and close themselves",
  "windows": [
    "quicklook",
    "quicklook-pin-*"
  ],
  "platforms": [
    "windows"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close"
  ]
}
